# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Port
PORT=8000

# Backend URL (API Base URL)
BACKEND_URL=https://mb-grocery-production.up.railway.app

# MongoDB Database URL (अगर MongoDB use kar rahe ho)
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Secret (अगर Authentication use kar rahe ho)
# JWT_SECRET=your-super-secret-jwt-key-here

# Environment
NODE_ENV=production

# CORS (Allow Frontend URLs)
CORS_ORIGIN=https://agile-blessing-production.up.railway.app

# ==========================================
# ✅ अब Railway वाला BACKEND_URL डाल दिया है!
# ==========================================